<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="robotic_arm_model_v3_ros2_control" params="name initial_positions_file use_sim:=false headless:=false">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_sim == 'mujoco'}">
                    <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
                    <param name="mujoco_model">$(find robotic_arm_v3_config)/config/mujoco/arm_scene.xml</param>
                    <param name="headless">${headless}</param>
                    <param name="sim_speed_factor">1.0</param>
                </xacro:if>
                <xacro:if value="${use_sim == 'gazebo'}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:if value="${use_sim == 'false' or use_sim == False}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
            </hardware>

            <xacro:macro name="configure_joint" params="joint_name">
                <joint name="${joint_name}">
                    <command_interface name="position"/>
                    <state_interface name="position">
                      <param name="initial_value">${initial_positions[joint_name]}</param>
                    </state_interface>
                    <state_interface name="velocity"/>
                </joint>
            </xacro:macro>

            <xacro:configure_joint joint_name="joint_1"/>
            <xacro:configure_joint joint_name="joint_2"/>
            <xacro:configure_joint joint_name="joint_3"/>
            <xacro:configure_joint joint_name="joint_4"/>

            <joint name="end_effector_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['end_effector_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

            <joint name="end_effector_bottom_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['end_effector_bottom_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="end_effector_top_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['end_effector_top_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>