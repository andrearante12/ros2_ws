<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotic_arm_model_v3">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <!-- use_sim: mujoco → mujoco_ros2_control/MujocoSystemInterface
                 gazebo → gz_ros2_control/GazeboSimSystem + Gazebo plugin
                 false  → mock_components/GenericSystem (MoveIt-only sim) -->
    <xacro:arg name="use_sim" default="false" />
    <xacro:arg name="headless" default="false" />

    <!-- Import robotic_arm_model_v3 urdf file -->
    <xacro:include filename="$(find robotic_arm_model_v3)/urdf/robotic_arm_model_v3.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="robotic_arm_model_v3.ros2_control.xacro" />

    <xacro:robotic_arm_model_v3_ros2_control
        name="ArmSystem"
        initial_positions_file="$(arg initial_positions_file)"
        use_sim="$(arg use_sim)"
        headless="$(arg headless)"/>

    <!-- When running in Gazebo, inject the gz_ros2_control system plugin.
         The <gazebo> tag is converted to a <plugin> element in the SDF
         that Gazebo loads when it spawns the robot from robot_description. -->
    <xacro:if value="${'$(arg use_sim)' == 'gazebo'}">
        <gazebo>
            <plugin filename="gz_ros2_control-system"
                    name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find robotic_arm_v3_config)/config/ros2_controllers.yaml</parameters>
                <ros>
                    <namespace>/</namespace>
                </ros>
            </plugin>
        </gazebo>
    </xacro:if>

</robot>
